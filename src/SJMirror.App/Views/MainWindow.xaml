<Window x:Class="SJMirror.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SJMirror.App.ViewModels"
        xmlns:models="clr-namespace:SJMirror.App.Models"
        Title="SJ Mirror"
        Width="960"
        Height="620"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed">
    <Window.Resources>
        <viewModels:AndroidDeviceStateToBrushConverter
            x:Key="DeviceStateBrushConverter"
            ConnectedBrush="{StaticResource DeviceConnectedBrush}"
            UnauthorizedBrush="{StaticResource DeviceUnauthorizedBrush}"
            OfflineBrush="{StaticResource DeviceOfflineBrush}"
            UnknownBrush="{StaticResource DeviceUnknownBrush}" />
    </Window.Resources>
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="20"
                    Background="White"
                    BorderBrush="#D9DEE5"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Devices" />

                    <ListBox Grid.Row="1"
                             Margin="0,18,0,18"
                             BorderThickness="0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Top"
                                             Margin="0,6,0,0"
                                             Fill="{Binding State, Converter={StaticResource DeviceStateBrushConverter}}" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Model, TargetNullValue=Android device}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="#667085"
                                                   Text="{Binding AndroidVersion, StringFormat=Android {0}, TargetNullValue=Android version unavailable}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="#667085">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Unknown" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectionType}" Value="{x:Static models:AndroidConnectionType.Usb}">
                                                            <Setter Property="Text" Value="USB" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConnectionType}" Value="{x:Static models:AndroidConnectionType.Network}">
                                                            <Setter Property="Text" Value="Wi-Fi" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,3,0,0" Foreground="#667085">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Unknown state" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:AndroidDeviceState.Device}">
                                                            <Setter Property="Text" Value="Connected" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:AndroidDeviceState.Unauthorized}">
                                                            <Setter Property="Text" Value="Authorization required" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:AndroidDeviceState.Offline}">
                                                            <Setter Property="Text" Value="Device offline" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <Button Height="38"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />
                        <Button Height="38"
                                Margin="0,8,0,0"
                                Click="ConnectWirelessly_Click"
                                Content="Connect wirelessly" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#667085"
                                   Text="Refreshing...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="48">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="500">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock HorizontalAlignment="Center"
                               Foreground="#667085"
                               FontSize="16"
                               Text="Android Device" />
                    <TextBlock Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedDeviceName}" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               Text="{Binding SelectedDeviceManufacturer}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#667085"
                               Text="{Binding SelectedAndroidVersion}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#667085"
                               Text="{Binding SelectedConnectionType}" />

                    <Border Margin="0,24,0,0"
                            Padding="18"
                            CornerRadius="6"
                            Background="White"
                            BorderBrush="#D9DEE5"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedStateTitle}" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#667085"
                                       Text="{Binding SelectedStateDescription}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="6"
                            Background="White"
                            BorderBrush="#D9DEE5"
                            BorderThickness="1">
                        <StackPanel Width="300">
                            <TextBlock FontWeight="SemiBold" Text="Mirror settings" />
                            <TextBlock Margin="0,10,0,4" Foreground="#667085" Text="Quality" />
                            <ComboBox ItemsSource="{Binding QualityProfiles}"
                                      SelectedItem="{Binding QualityProfile, Mode=TwoWay}" />
                            <CheckBox Margin="0,10,0,0"
                                      IsChecked="{Binding TurnScreenOff, Mode=TwoWay}"
                                      Content="Turn phone screen off" />
                            <CheckBox Margin="0,8,0,0"
                                      IsChecked="{Binding StayAwake, Mode=TwoWay}"
                                      Content="Keep device awake" />
                            <CheckBox Margin="0,8,0,0"
                                      IsChecked="{Binding AutoMirror, Mode=TwoWay}"
                                      Content="Auto mirror when device connects" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#8A94A2"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="{Binding SettingsChangeMessage}" />
                        </StackPanel>
                    </Border>

                    <Button Width="150"
                            Height="40"
                            Margin="0,18,0,0"
                            Command="{Binding MirrorCommand}"
                            Content="Mirror">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMirrorSessionActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanStartMirror}" Value="False">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="150"
                            Height="40"
                            Margin="0,24,0,0"
                            Command="{Binding StopMirrorCommand}"
                            Content="Stop">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMirrorSessionActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#8A94A2"
                               FontSize="11"
                               Text="{Binding MirrorMessage}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="430">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Text="No Android device detected" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#667085"
                               FontSize="15"
                               Text="Connect a device using USB and enable USB debugging." />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Padding="18,0" Background="#20252B">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Text="{Binding AdbStatus}" />
                <TextBlock Grid.Column="1"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#D0D5DD"
                           Text="{Binding StatusMessage}" />
            </Grid>
        </Border>
    </Grid>
</Window>
